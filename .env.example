# PASTE - AI-Powered Product Intelligence Engine
# Environment configuration

# Database
DATABASE_URL=postgresql+asyncpg://paste:***REMOVED***@localhost:5432/paste
POSTGRES_PASSWORD=***REMOVED***

# VLM (llama.cpp)
VLM_MODEL_PATH=/models/qwen2-vl-7b-instruct-q4_k_m.gguf
VLM_N_CTX=8192
VLM_N_GPU_LAYERS=-1
VLM_TEMPERATURE=0.1
VLM_TOP_P=0.95

# Redis (for job queue)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=***REMOVED***
API_KEY_HASH_SALT=***REMOVED***
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Optional: set this to require an API key on every request (Bearer token / X-API-Key).
# Leave empty for local dev (auth disabled with a startup warning).
PASTE_API_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Processing
MAX_CONCURRENT_JOBS=2
EXTRACTION_PASS_COUNT=2
CONFIDENCE_AUTO_APPROVE=0.90
CONFIDENCE_INFERRED_CAP=0.70
CONFIDENCE_FORCED_REVIEW=0.50

# File uploads
UPLOAD_DIR=/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff

# CORS - comma-separated list of allowed origins. Use specific origins in production.
CORS_ORIGINS=*

# Export
EXPORT_DIR=/exports